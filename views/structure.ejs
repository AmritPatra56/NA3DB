<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NA3DB · <%= entry.pdb_id %></title>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/assets/favicon.ico" sizes="32x32">
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
    <link rel="stylesheet" href="/style.css">
<%- include("includes/theme.ejs") %>
</head>
<body>
<%
    // Rows from detail.js, which the cards read too.
    const fasta_url = `/structure/${entry.pdb_id}/fasta`;
%>
    <div class="interface">
        <%- include("includes/rail.ejs") %>
        <div class="results_area">
            <div class="results_area_header">
                <h1><%= entry.pdb_id %></h1>
            </div>
            <div class="results_area_body">
                <div class="structure_page">
                    <nav class="section_nav" id="section_nav" aria-label="Sections of this page">
                        <% for (const g of PAGE_GROUPS) { %>
                            <div class="nav_group group_<%= g.key %>">
                                <%# A group that is one section of the same name (Overview) is
                                    its own link, not a label over a repeat of itself. %>
                                <% const in_group = sections.filter((s) => s.group === g.key); %>
                                <% if (in_group[0].title !== g.label) { %><div class="nav_group_label"><%= g.label %></div><% } %>
                                <% for (const s of in_group) { %>
                                    <a href="#<%= s.id %>" class="nav_item<%= s.title === g.label ? " nav_solo" : "" %><%= s.empty ? " empty" : "" %>"><%= s.title %></a>
                                <% } %>
                            </div>
                        <% } %>
                    </nav>
                    <%# The full search's drawer handle, on the sidebar's edge: folded,
                        the sidebar slides away and the handle stays on the page's
                        edge. Only on a wide screen, where it is a sidebar. %>
                    <div class="nav_edge">
                        <button type="button" class="panel_handle nav_handle" aria-controls="section_nav"
                                aria-expanded="true" aria-label="Hide the sections" title="Hide the sections">
                            <i class="arrow arrow_side" aria-hidden="true"></i>
                        </button>
                    </div>
                    <%# Folded or not as last time, before the page is drawn. %>
                    <script>
                        try { if (localStorage.getItem("section_nav") === "folded") document.querySelector(".structure_page").classList.add("nav_folded"); } catch {}
                        try { if (localStorage.getItem("views_wide") === "on") document.querySelector(".structure_page").classList.add("views_wide"); } catch {}
                    </script>

                <%# --rows: the sections beside the Views on a wide screen, where the
                    Views take a column of their own (style.css). %>
                <div class="detail_body" style="--rows: <%= sections.length - 1 %>">

                    <% for (const s of sections) { const group = PAGE_GROUPS.find((g) => g.key === s.group); %>
                    <section id="<%= s.id %>" class="page_section group_<%= s.group %><%= s.empty ? " empty" : "" %>" aria-labelledby="<%= s.id %>-title">
                        <div class="section_band">
                            <div class="band_title">
                                <% if (group.label !== s.title) { %><span class="band_group"><%= group.label %></span><% } %>
                                <h2 id="<%= s.id %>-title"><%= s.title %></h2>
                            </div>
                            <div class="band_tools">
                                <% if (s.id === "molecules" && molecules.fasta.na && molecules.fasta.na < molecules.fasta.all) { %>
                                    <details class="entry_fasta">
                                        <summary class="download download_small" title="Download sequences as FASTA">FASTA</summary>
                                        <div class="entry_fasta_menu">
                                            <a href="<%= fasta_url %>?only=na" download>Nucleic acids only <span><%= molecules.fasta.na %> <%= molecules.fasta.na === 1 ? "molecule" : "molecules" %></span></a>
                                            <a href="<%= fasta_url %>" download>All polymers <span><%= molecules.fasta.all %> molecules</span></a>
                                        </div>
                                    </details>
                                <% } else if (s.id === "molecules" && molecules.fasta.all) { %>
                                    <a class="download download_small" href="<%= fasta_url %>" download title="Download <%= molecules.fasta.all === 1 ? "the sequence" : "all " + molecules.fasta.all + " sequences" %> as FASTA">FASTA</a>
                                <% } else if (s.id === "base-pairs" && base_pairs) { %>
                                    <a class="download download_small" href="/api/entries/<%= entry.pdb_id %>/base_pairs?format=csv" download title="Download every pair as CSV">CSV</a>
                                <% } %>
                                <%# Which column is the wide one. In the band rather than on
                                    the line between the columns: a handle out there was a
                                    shape nobody read. Says what the click does, not what is
                                    on screen. Only where there are two columns to swap
                                    (style.css). %>
                                <% if (s.id === "views") { %>
                                    <button type="button" class="download download_small band_swap" aria-pressed="false">
                                        <span class="band_swap_say">Enlarge views</span>
                                    </button>
                                <% } %>
                                <%- include("includes/help", { key: s.id }) %>
                                <button type="button" class="band_fold" aria-expanded="true" aria-controls="<%= s.id %>-body" title="Fold this section"><i class="arrow" aria-hidden="true"></i></button>
                            </div>
                        </div>
                        <div class="section_body" id="<%= s.id %>-body">
                        <% for (const row of s.rows ?? []) { %>
                            <div class="detail_field<%= row.key === "title" ? " structure_lead" : "" %>">
                                <div class="detail_label"><%= row.label %></div>
                                <% if (row.key === "published" && locals.citation) { %>
                                <div class="detail_value published_value"><span><%= row.value %></span><%- include("includes/cite_save.ejs", { where: "top" }) %></div>
                                <% } else { %>
                                <div class="detail_value"><%= row.value %></div>
                                <% } %>
                            </div>
                        <% } %>
                        <% if (s.id === "conformation" && s.ntc?.families.length) { const t = s.ntc; const fmt = (n) => n.toLocaleString("en-GB"); %>
                            <div class="pair_caption">Steps by shape, each colour named</div>
                                <details class="guide">
                                    <summary>How the colours work</summary>
                                    <div class="guide_body">
                                        <p>The colours are DNATCO's. Each NtC is drawn in two halves, its 5′ side and its 3′ side, and each half takes the colour of its conformer class: AB01 is A then B, BB07 is BII on both sides. A low pale grey box (N) is a step DNATCO could not class.</p>
                                        <div class="cana_key"><% for (const k of t.key) { %><span><i class="cana_swatch" style="background:<%= k.background %>"></i><code><%= k.code %></code><%= k.name %></span><% } %></div>
                                        <p class="guide_source">Classes and their meaning: <a target="_blank" rel="noopener" href="https://doi.org/10.1093/nar/gkaa383">DNATCO, Černý et al. 2020, NAR 48:6367</a>. Colours: <a target="_blank" rel="noopener" href="https://dnatco.datmos.org">DNATCO, as on its own site</a>.</p>
                                    </div>
                                </details>
                            <% for (const f of t.families) { %>
                                <div class="ntc_family_name"><%= f.name %> · <%= fmt(f.n) %> <%= f.n === 1 ? "step" : "steps" %></div>
                                <% for (const c of f.classes) { %>
                                    <div class="ntc_line">
                                        <span class="ntc_name"><b><%= c.name %></b> <code><%= c.cana %></code></span>
                                        <span class="ntc_count"><%= fmt(c.n) %></span>
                                        <span class="ntc_chips"><% for (const x of c.ntcs) { %><span class="ntc_chip" title="<%= x.ntc %>: <%= fmt(x.n) %> <%= x.n === 1 ? "step" : "steps" %>"><i class="cana_swatch" style="background:<%= x.background %>"></i><%= x.ntc %> ×<%= fmt(x.n) %></span><% } %></span>
                                    </div>
                                <% } %>
                            <% } %>
                        <% } %>
                        <% if (s.groups?.length > 1) { %>
                            <div class="jump_to">Jump to: <% s.groups.forEach((g, i) => { %><%= i ? " · " : "" %><a href="#<%= s.id %>-<%= g.kind.toLowerCase().replace(/[^a-z]+/g, "-") %>"><%= g.title %></a><% }) %></div>
                        <% } %>
                        <% if (s.id === "molecules" && molecules.summary) { %>
                            <div class="molecules_summary"><span><%= molecules.summary %></span></div>
                        <% } %>
                        <% for (const g of s.groups ?? []) { %>
                            <div id="<%= s.id %>-<%= g.kind.toLowerCase().replace(/[^a-z]+/g, "-") %>">
                                <%- include("includes/molecule_group.ejs", { g, entry }) %>
                            </div>
                        <% } %>

                        <% if (s.id === "base-pairs" && arcs) { const a = arcs; const strands = a.chains.length; const labelled = strands <= 8; %>
                            <figure class="arc_picture">
                                <% const v = locals.arc_view ?? { options: [], key: "", assembly: false, note: null, about: [] }; if (v.options.length) { %>
                                <nav class="arc_views" aria-label="Which chains to draw">
                                    <% for (const o of v.options) { %><a href="?assembly=<%= o.key %>#base-pairs" title="<%= o.title %>"<% if (o.current) { %> aria-current="true"<% } %>><%= o.label %></a><% } %>
                                </nav>
                                <% } %>
                                <button type="button" class="arc_zoom" data-arc-open="<%= entry.pdb_id %>" data-arc-view="<%= v.key %>" title="Expand">
                                <svg viewBox="0 0 <%= a.width %> <%= a.height %>" role="img" aria-label="Arc diagram: <%= a.counts.drawn %> base pairs drawn as arcs over <%= strands === 1 ? "one strand" : strands + " strands" %> (<%= a.chains.map((c) => c.name).join(", ") %>), <%= a.counts.nucleotides.toLocaleString("en-GB") %> nucleotides">
                                    <% for (const c of a.chains) { %><line class="arc_strand<%= c.symmetry ? " arc_copy" : "" %>" x1="<%= c.x1 %>" y1="<%= a.base %>" x2="<%= c.x2 %>" y2="<%= a.base %>"/><% } %>
                                    <g class="arc_lines" stroke-width="<%= a.stroke %>">
                                    <% if (a.each) { for (const e of a.each) { %><path class="arc_<%= e.kind %>" d="<%= e.d %>"><title><%= e.label %></title></path><% } } else { %>
                                    <path class="arc_nc" d="<%= a.paths.nc %>"/>
                                    <path class="arc_gu" d="<%= a.paths.gu %>"/>
                                    <path class="arc_wc" d="<%= a.paths.wc %>"/>
                                    <% } %>
                                    </g>
                                    <% if (a.dot_path) { %><path class="arc_dot" d="<%= a.dot_path %>"/><% } %>
                                    <% if (labelled) { for (const c of a.chains) { const wide = c.x2 - c.x1 >= 30; %>
                                    <% if (wide) { %><text class="arc_name" x="<%= c.x1 %>" y="<%= a.bottom + 14 %>">5′</text><text class="arc_name arc_end" x="<%= c.x2 %>" y="<%= a.bottom + 14 %>">3′</text><% } %>
                                    <% if ((strands > 1 || c.symmetry) && c.x2 - c.x1 >= 12) { %><text class="arc_name arc_mid" x="<%= Math.round((c.x1 + c.x2) * 5) / 10 %>" y="<%= a.bottom + 14 %>"><%= c.name %></text><% } %>
                                    <% } } %>
                                </svg>
                                </button>
                                <figcaption>
                                    <span><%= strands === 1 ? "1 strand" : strands + " strands" %> · <%= a.counts.nucleotides.toLocaleString("en-GB") %> nt<% if (a.each) { %> · hover an arc for its pair<% } %><button type="button" class="arc_full" data-arc-open="<%= entry.pdb_id %>" data-arc-view="<%= v.key %>" aria-expanded="false">⤢ Expand</button></span>
                                    <span class="arc_key"><% for (const [kind, label] of [["wc", "cWW Watson–Crick"], ["gu", "cWW G–U"], ["nc", "Others"]]) { if (a.paths[kind]) { %><span><i class="arc_<%= kind %>"></i><%= label %></span><% } } %><% if (a.counts.modified) { %><span><i class="arc_mod"></i>modified</span><% } %></span>
                                    <% for (const line of v.about ?? []) { %><span class="arc_note"><%= line %></span><% } %>
                                    <% if (a.counts.copies && !v.assembly) { %><span class="arc_note">′ marks a copy from the crystal's symmetry</span><% } %>
                                    <% if (v.note) { %><span class="arc_note"><%= v.note.text %><% if (v.note.link) { %> <a href="?assembly=<%= v.note.link %>#base-pairs"><%= v.note.link_text %></a><% } %></span><% } %>
                                </figcaption>
                            </figure>
                        <% } %>
                        <% if (s.id === "views" && !s.empty) { %>
                            <%- include("includes/views.ejs") %>
                        <% } %>
                        <% if (s.id === "sequence-map" && !s.empty) { %>
                            <%- include("includes/map_guide.ejs") %>
                            <div class="seqmap" data-entry="<%= entry.pdb_id %>">
                                <p class="seqmap_wait">Drawing the sequence map…</p>
                            </div>
                        <% } %>
                        <% if (s.id === "same-sequence" && !s.empty) { %>
                            <div class="sameseq" data-entry="<%= entry.pdb_id %>">
                                <p class="seqmap_wait">Finding the chains with this sequence…</p>
                            </div>
                        <% } %>
                        <% if (s.id === "base-pairs" && base_pairs) { const bp = base_pairs; %>
                            <div class="jump_to">Jump to: <a href="#bp-counts">Counts</a><% if (bp.families.length) { %> · <a href="#bp-families">Families</a><% } %><% if (bp.noncanonical.length) { %> · <a href="#bp-all">Other pairs</a><% } %></div>
                        <div class="source_legend pair_head">
                            <span><%= bp.total.toLocaleString("en-GB") %> <%= bp.total === 1 ? "pair" : "pairs" %>, Leontis–Westhof classes from DNATCO</span>
                        </div>
                        <div id="bp-counts" class="pair_bar" role="img" aria-label="<%= bp.bar.map((b) => `${b.n} ${b.label}`).join(', ') %>">
                            <% for (const b of bp.bar) { if (!b.n) continue; %><span class="pair_<%= b.kind %>" style="flex:<%= b.n %>"><% if (b.percent >= 15) { %><%= b.n.toLocaleString("en-GB") %><span class="pair_bar_label"><%= b.label %></span><% } %></span><% } %>
                        </div>
                        <div class="pair_legend"><% for (const b of bp.bar) { %><span><i class="pair_<%= b.kind %>"></i><%= b.label %> <%= b.n.toLocaleString("en-GB") %></span><% } %></div>
                        <% if (bp.families.length) { %>
                            <div id="bp-families" class="pair_caption">Others, by Leontis–Westhof family</div>
                            <div class="pair_families"><% for (const f of bp.families) { %><span title="<%= f.name %>"><%= f.family %> <%= f.n.toLocaleString("en-GB") %></span><% } %></div>
                        <% } %>
                        <% if (bp.sentence) { %>
                            <p class="pair_chains"><%= bp.sentence %></p>
                        <% } else { %>
                            <ul class="pair_links"><% bp.links.slice(0, bp.links_shown).forEach((l) => { %><li><%= l.text %></li><% }) %></ul>
                            <% if (bp.links.length > bp.links_shown) { %>
                                <details class="more_positions"><summary><%= bp.links.length - bp.links_shown %> more chain pairings</summary>
                                    <ul class="pair_links"><% bp.links.slice(bp.links_shown).forEach((l) => { %><li><%= l.text %></li><% }) %></ul>
                                </details>
                            <% } %>
                        <% } %>
                        <% if (bp.noncanonical.length) { %>
                            <details id="bp-all" class="pair_list">
                                <summary>Show the <%= bp.noncanonical.length.toLocaleString("en-GB") %> other pairs</summary>
                                <%# Linked to the 1D view: a pair is shown there, and a
                                    nucleotide there finds its row here (public/views.js). %>
                                <p class="pair_hint">Select a pair to show it in the 1D view.</p>
                                <div class="molecule_scroll">
                                <table class="molecule_table pair_table">
                                    <tr><th>Chain</th><th>Pair</th><th>Family</th></tr>
                                    <% for (const p of bp.noncanonical) { %><tr data-a="<%= p.ends[0] %>" data-b="<%= p.ends[1] %>"><td><%= p.chain %></td><td><a class="pair_show" href="#views"><%= p.pair %></a></td><td title="<%= p.name %>"><%= p.family %></td></tr><% } %>
                                </table>
                                </div>
                            </details>
                        <% } %>
                        <% } %>

                        <% if (s.id === "sources" && molecules.sources) { const src = molecules.sources; %>
                        <% const esc = (t) => String(t).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]); %>
                        <% const NONE = '<span class="molecule_sub">none</span>'; %>
                        <% const org = (o) => !o ? NONE : (o.italic ? `<i>${esc(o.name)}</i>` : esc(o.name)) + (o.common ? ` <span class="molecule_sub">(${esc(o.common)})</span>` : ""); %>
                        <% const tax = (t) => t ? `<a target="_blank" rel="noopener" title="NCBI Taxonomy" href="${t.url}">${t.id}</a>` : NONE; %>
                        <div class="source_legend"><% src.legend.forEach((l, i) => { %><%= i ? " · " : "" %><b><%= l.kind %></b> = <%= l.text %><% }) %></div>
                        <div class="molecule_scroll">
                        <table class="molecule_table source_table">
                            <% if (src.notes) { %><colgroup><col style="width:20%"><col style="width:9%"><col style="width:10%"><col style="width:23%"><col style="width:8%"><col style="width:16%"><col style="width:14%"></colgroup>
                            <% } else { %><colgroup><col style="width:24%"><col style="width:10%"><col style="width:11%"><col style="width:27%"><col style="width:9%"><col style="width:19%"></colgroup><% } %>
                            <tr><th>Molecule</th><th>Chains</th><th>Obtained</th><th>Organism</th><th>Taxonomy ID</th><th>Produced in</th><% if (src.notes) { %><th>Notes</th><% } %></tr>
                            <% for (const r of src.rows) { const n = r.segments.length; %>
                                <% r.segments.forEach((seg, i) => { %>
                                    <tr<% if (i < n - 1) { %> class="segment_continues"<% } %>>
                                        <% if (i === 0) { %>
                                            <td rowspan="<%= n %>"><% if (r.listed) { %><% for (const m of r.molecules) { %><div><%= m.name %></div><% } %><% } else { %><details class="more_positions"><summary><%= r.molecules.length %> molecules</summary><% for (const m of r.molecules) { %><div><%= m.name %> <span class="molecule_sub"><%= m.chains.join(", ") %></span></div><% } %></details><% } %></td>
                                            <td rowspan="<%= n %>"><% if (r.listed) { %><% for (const m of r.molecules) { %><div><%= m.chains.join(", ") %></div><% } %><% } else { %><%= r.chain_count %> chains<% } %></td>
                                            <td rowspan="<%= n %>"><span class="source_kind source_<%= r.kind.toLowerCase().replace(" ", "_") %>"><%= r.kind %></span></td>
                                        <% } %>
                                        <td><% if (seg.range) { %><b><%= seg.range %></b> <% } %><%- org(seg.organism) %></td>
                                        <td><%- tax(seg.taxon) %></td>
                                        <% if (i === 0) { %>
                                            <td rowspan="<%= n %>"><%- r.host ? `${org(r.host.organism)}${r.host.taxon ? ` (${tax(r.host.taxon)})` : ""}` : NONE %></td>
                                        <% } %>
                                        <% if (src.notes) { %><td class="molecule_sub"><%= seg.notes ?? "" %></td><% } %>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </table>
                        </div>
                        <% } %>

                        <% if (s.id === "citations" && locals.citation) { const c = citation; %>
                            <div class="citation">
                                <% if (c.title) { %><div class="citation_title"><%= c.title %></div><% } %>
                                <% if (c.authors.length) { %><div class="citation_authors"><%= c.authors.map(full_name).join(", ") %></div><% } %>
                                <div class="citation_source">
                                    <% if (cite_unpublished) { %>Not yet published.<% } else if (c.type === "preprint") { %>
                                    <i><%= c.journal %></i> preprint<% if (c.year) { %> (<%= c.year %>)<% } %>
                                    <% } else { %>
                                    <% if (c.type === "chapter" && c.book_title) { %>In <i><%= c.book_title %></i>.<% } %>
                                    <% if (c.journal) { %><i><%= c.journal %></i><% } %>
                                    <%= [c.volume && c.volume + (c.issue ? `(${c.issue})` : ""), c.pages].filter(Boolean).join(", ") %>
                                    <% if (c.year) { %>(<%= c.year %>)<% } %>
                                    <% } %>
                                </div>
                                <% if (c.abstract) { %>
                                <details class="citation_abstract">
                                    <summary>Abstract</summary>
                                    <p><%= c.abstract %></p>
                                </details>
                                <% } %>
                                <div class="citation_actions">
                                    <%- include("includes/cite_save.ejs", { where: "section" }) %>
                                    <button type="button" class="sequence_copy cite_copy" data-text="<%= cite_text %>" title="Copy the citation as text" aria-label="Copy the citation as text"><svg class="icon_copy" viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg><svg class="icon_done" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>Copy</button>
                                    <% if (c.doi_url) { %><a class="detail_link" target="_blank" rel="noopener" href="<%= c.doi_url %>">DOI <%= c.doi %></a><% } %>
                                    <% if (c.pubmed_url) { %><a class="detail_link" target="_blank" rel="noopener" href="<%= c.pubmed_url %>">PubMed <%= c.pubmed %></a><% } %>
                                </div>
                            </div>
                        <% } %>

                        <% if (s.id === "links") { %>
                            <div class="link_files">
                                <% if (molecules.fasta.all) { %><a class="download" href="<%= fasta_url %>" download>Sequences as FASTA</a><% } %>
                                <% if (base_pairs) { %><a class="download" href="/api/entries/<%= entry.pdb_id %>/base_pairs?format=csv" download>Base pairs as CSV</a><% } %>
                            </div>
                            <ul class="link_list">
                                <li><a target="_blank" rel="noopener" href="https://www.rcsb.org/structure/<%= entry.pdb_id %>">View on rcsb.org</a></li>
                                <li><a href="/report<%= rail_query %>">Report of this entry, as CSV or Excel</a></li>
                                <li><a href="/api/entries/<%= entry.pdb_id %>">This entry as JSON</a></li>
                            </ul>
                        <% } %>

                        <% if (s.empty && s.id === "same-sequence") { %>
                            <p class="section_none">No other entry has a chain with exactly this sequence.</p>
                        <% } else if (s.empty) { %>
                            <p class="section_none">None recorded for this entry.</p>
                        <% } %>
                        </div>
                    </section>
                    <% } %>
                </div>
                </div>
            </div>
        </div>
    </div>
    <% if (arcs) { %>
    <%- include("includes/arc_viewer.ejs") %>
    <% } %>
    <% if (sections.some((s) => s.id === "views" && !s.empty)) { %><script type="module" src="/views.js"></script><% } %>
    <% if (sections.some((s) => s.id === "sequence-map" && !s.empty)) { %><script type="module" src="/seqmap.js"></script><% } %>
    <% if (sections.some((s) => s.id === "same-sequence" && !s.empty)) { %><script type="module" src="/sameseq.js"></script><% } %>
    <script>
        // A sequence: the letters only, no line numbers, no block spaces.
        // The citation: the one line it carries.
        document.addEventListener("click", async (event) => {
            let button = event.target.closest(".sequence_copy");
            if (!button) return;
            let text = button.dataset.text ?? [...button.closest(".sequence").querySelectorAll(".sequence_text")]
                .map((t) => t.textContent).join("").replace(/\s/g, "");
            let title = (button.dataset.title ??= button.title);
            try {
                await navigator.clipboard.writeText(text);
            } catch {
                // No clipboard permission (an embedded or plain-http page):
                // copy through a hidden text box instead.
                let box = Object.assign(document.createElement("textarea"), { value: text });
                document.body.append(box);
                box.select();
                document.execCommand("copy");
                box.remove();
            }
            button.classList.add("copied");
            button.title = "Copied";
            setTimeout(() => { button.classList.remove("copied"); button.title = title; }, 1500);
        });

        // A long table shows its first rows; the button reveals or hides the rest.
        document.addEventListener("click", (event) => {
            let button = event.target.closest(".more_rows_toggle");
            if (!button) return;
            let more = button.closest("table").querySelector(".more_rows");
            more.hidden = !more.hidden;
            button.setAttribute("aria-expanded", String(!more.hidden));
            button.firstElementChild.textContent = more.hidden ? button.dataset.more : button.dataset.less;
        });

        // A download menu (FASTA, Save reference) closes once a file is
        // picked or the click lands elsewhere.
        document.addEventListener("click", (event) => {
            for (const menu of document.querySelectorAll("details.entry_fasta[open]")) {
                if (!menu.contains(event.target) || event.target.closest("a")) menu.open = false;
            }
        });

        // A band's chevron folds its section; arriving at a folded section by
        // a link opens it again, or the link would land on nothing.
        function fold(section, folded) {
            section.querySelector(".section_body").hidden = folded;
            let button = section.querySelector(".band_fold");
            button.setAttribute("aria-expanded", String(!folded));
            button.title = folded ? "Open this section" : "Fold this section";
        }

        document.addEventListener("click", (event) => {
            let button = event.target.closest(".band_fold");
            if (button) fold(button.closest(".page_section"), button.getAttribute("aria-expanded") === "true");

            let link = event.target.closest('a[href^="#"]');
            let target = link && document.getElementById(link.getAttribute("href").slice(1));
            let section = target?.closest(".page_section");
            if (section) fold(section, false);

            // Only one help note open at a time, and a click elsewhere shuts it.
            for (const help of document.querySelectorAll(".help[open]")) {
                if (!help.contains(event.target)) help.open = false;
            }
        });

        // Escape shuts an open help note and hands focus back to its "?".
        document.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") return;
            for (const help of document.querySelectorAll(".help[open]")) {
                help.open = false;
                help.querySelector("summary").focus();
            }
        });

        // The sidebar slides away and back, and is kept that way for the
        // next structure.
        const nav_fold = document.querySelector(".nav_handle");
        const nav_page = document.querySelector(".structure_page");
        const nav_list = document.querySelector(".section_nav");
        const nav_strip = matchMedia("(max-width: 1023px)");
        function nav_folded(on) {
            nav_page.classList.toggle("nav_folded", on);
            // Out of sight, its links leave the tab order, as the filters do.
            // Only beside the page: the strip on a narrow screen never folds.
            nav_list.inert = on && !nav_strip.matches;
            let label = on ? "Show the sections" : "Hide the sections";
            nav_fold.setAttribute("aria-expanded", String(!on));
            nav_fold.setAttribute("aria-label", label);
            nav_fold.title = label;
        }
        let nav_now = () => nav_folded(nav_page.classList.contains("nav_folded"));
        nav_now();
        nav_strip.addEventListener("change", nav_now);
        nav_fold.addEventListener("click", () => {
            let on = !nav_page.classList.contains("nav_folded");
            nav_folded(on);
            try { localStorage.setItem("section_nav", on ? "folded" : "open"); } catch {}
        });

        // Which column is the wide one. The button lives on the Views band and
        // the class on .structure_page, because the grid that has to change is
        // the one both columns are in.
        const swap = document.querySelector(".band_swap");
        swap?.addEventListener("click", () => {
            let on = document.querySelector(".structure_page").classList.toggle("views_wide");
            swap.setAttribute("aria-pressed", String(on));
            swap.querySelector(".band_swap_say").textContent = on ? "Shrink views" : "Enlarge views";
            try { localStorage.setItem("views_wide", on ? "on" : "off"); } catch {}
        });
        if (swap && document.querySelector(".structure_page").classList.contains("views_wide")) {
            swap.setAttribute("aria-pressed", "true");
            swap.querySelector(".band_swap_say").textContent = "Shrink views";
        }

        // The sidebar follows the reading position: the current section is the
        // last one whose band has passed the top of the reading area. The
        // address follows too, so a copied link opens at the same place.
        const nav = document.querySelector(".section_nav");
        const items = new Map([...nav.querySelectorAll(".nav_item")]
            .map((a) => [a.getAttribute("href").slice(1), a]));
        const sections = [...document.querySelectorAll(".page_section")];
        let current = null;
        let queued = false;

        function follow() {
            queued = false;
            let strip = matchMedia("(max-width: 1023px)").matches;
            let line = strip ? nav.getBoundingClientRect().bottom + 24
                             : document.querySelector(".results_area_body").getBoundingClientRect().top + 80;
            let here = sections.filter((s) => s.getBoundingClientRect().top <= line).at(-1) ?? sections[0];

            // At the very bottom, the last short sections can never reach the
            // line, so the end of the page counts as the last section.
            let scroller = document.querySelector(".results_area_body");
            let end = scroller.scrollHeight > scroller.clientHeight
                ? scroller.scrollTop + scroller.clientHeight >= scroller.scrollHeight - 2
                : innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
            if (end && scrollY + scroller.scrollTop > 0) here = sections.at(-1);

            if (here === current) return;
            current?.id && items.get(current.id)?.removeAttribute("aria-current");
            current = here;
            let item = items.get(here.id);
            item.setAttribute("aria-current", "true");
            if (nav.scrollWidth > nav.clientWidth) {
                nav.scrollLeft = item.offsetLeft - nav.clientWidth / 2 + item.offsetWidth / 2;
            }
            if (scrollY + scroller.scrollTop > 0) history.replaceState(null, "", "#" + here.id);

            // The Views follow the reading position too, where they sit
            // beside the page. Announced rather than done here: which view a
            // section is about, and what a view costs to open, are
            // views.js's business (in public), and it is the one file that knows
            // whether the reader has already chosen a view for themselves.
            document.dispatchEvent(new CustomEvent("na3db:section", { detail: here.id }));
        }

        document.addEventListener("scroll", () => {
            if (!queued) { queued = true; requestAnimationFrame(follow); }
        }, { capture: true, passive: true });
        addEventListener("resize", follow);
        follow();
    </script>
    <%- include("includes/footer.ejs") %>
</body>
</html>
