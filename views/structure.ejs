<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NA3DB — <%= entry.pdb_id %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="interface">
        <%- include("includes/rail.ejs") %>
        <div class="results_area">
            <div class="results_area_header">
                <h1><%= entry.pdb_id %></h1>
            </div>
            <div class="results_area_body">
                <div class="detail_body">
<%
// Label and value for every field worth showing, then drop the ones this entry
// has nothing for. Most entries are missing at least one, and a row reading
// "null" is worse than no row at all.
const rows = [
    ["Title",                 entry.title],
    ["Authors",               entry.all_authors || entry.author],
    ["Published",             entry.published],
    ["Method",                entry.method],
    ["Resolution",            entry.resolution === null ? null : entry.resolution + " Å"],
    ["Deposited",             entry.deposition_date],
    ["Entity",                entry.entity_name],
    ["Source organism",       entry.source_organism],
    ["Composition",           entry.polymer_composition],
    ["Polymer type",          entry.polymer_type],
    ["Chains",                entry.chain_count],
    ["Residues",              entry.residue_count],
    ["Atoms",                 entry.atom_count === null ? null : entry.atom_count.toLocaleString("en-GB")],
    ["Monomer flag",          entry.monomer_flag],
    ["Non-standard residues", entry.nonstandard_residue],
    ["Confal score",          entry.confal_score],
    ["Confal percentile",     entry.confal_percentile],
    ["NtC steps",             entry.ntc_step_count],
    ["NtC classes",           entry.ntc_classes],
    ["Assigned NtC",          entry.assigned_ntc],
    ["DOI",                   entry.doi],
    ["PubMed",                entry.pubmed]
].filter(function (row) {
    return row[1] !== null && row[1] !== undefined && row[1] !== "";
});
%>
                    <% for (const row of rows) { %>
                        <div class="detail_field">
                            <div class="detail_label"><%= row[0] %></div>
                            <div class="detail_value"><%= row[1] %></div>
                        </div>
                    <% } %>

                    <a class="detail_link" target="_blank" rel="noopener"
                       href="https://www.rcsb.org/structure/<%= entry.pdb_id %>">View on rcsb.org</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
