<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NA3DB — <%= entry.pdb_id %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="interface">
        <%- include("includes/rail.ejs") %>
        <div class="results_area">
            <div class="results_area_header">
                <h1><%= entry.pdb_id %></h1>
            </div>
            <div class="results_area_body">
                <div class="detail_body">
<%# Rows from detail.js, which the search page's panel reads too. %>
                    <% for (const row of rows) { %>
                        <div class="detail_field">
                            <div class="detail_label"><%= row.label %></div>
                            <div class="detail_value"><%= row.value %></div>
                        </div>
                    <% } %>

                    <a class="detail_link" target="_blank" rel="noopener"
                       href="https://www.rcsb.org/structure/<%= entry.pdb_id %>">View on rcsb.org</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
