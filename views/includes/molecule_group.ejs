<%# One table of the Molecules, Modified nucleotides or Ligands section. %>
<details class="molecule_group" <%= g.folded ? "" : "open" %>>
    <summary><%= g.title %> (<%= g.rows.length %>)</summary>
    <div class="molecule_scroll">
    <table class="molecule_table">
    <% const pos = (p) => p.seen ? p.num : `<span class="unmodelled" title="not modelled">${p.num}</span>`; %>
    <% if (g.modified) { %>
        <colgroup><col style="width:12%"><col style="width:46%"><col style="width:10%"><col style="width:32%"></colgroup>
        <thead><tr><th>Code</th><th>Name</th><th>Chain</th><th>Positions</th></tr></thead>
        <% g.rows.forEach((r, i) => { %>
            <% if (i === g.shown) { %></tbody><tbody class="more_rows" hidden><% } else if (i === 0) { %><tbody><% } %>
            <tr>
                <td><a target="_blank" rel="noopener" href="<%= r.url %>"><%= r.code %></a></td>
                <td><% if (r.name == null) { %><span class="molecule_sub">none</span><% } else { %><%= r.name %><% } %></td>
                <td><span<% if (r.chain.title) { %> title="<%= r.chain.title %>"<% } %>><%= r.chain.name %></span></td>
                <td><%- r.shown.map(pos).join(", ") %><% if (r.rest.length) { %><details class="more_positions"><summary>+ <%= r.rest.length %> more</summary><%- r.rest.map(pos).join(", ") %></details><% } %></td>
            </tr>
        <% }) %>
        </tbody>
        <% if (g.rows.length > g.shown) { %>
            <tfoot><tr><td colspan="4"><button type="button" class="more_rows_toggle" aria-expanded="false"
                data-more="Show all <%= g.rows.length %>" data-less="Show fewer">Show all <%= g.rows.length %></button></td></tr></tfoot>
        <% } %>
    <% } else if (g.polymer) { %>
        <colgroup><col style="width:36%"><col style="width:10%"><col style="width:20%"><col style="width:14%"><col style="width:20%"></colgroup>
        <tr><th>Molecule</th><th>Chain</th><th>Modelled</th><th>Numbering</th><th>Link</th></tr>
        <% for (const r of g.rows) { %>
            <tr>
                <td><%= r.name %><% if (r.length) { %><div class="molecule_sub"><%= r.length %></div><% } %></td>
                <td><% r.chains.forEach((c, i) => { %><%= i ? ", " : "" %><span<% if (c.title) { %> title="<%= c.title %>"<% } %>><%= c.name %></span><% }) %></td>
                <td><% if (r.modelled == null) { %><span class="molecule_sub">none</span><% } else { %><%= r.modelled %><% } %><% if (r.missing) { %><div class="molecule_sub">missing <%= r.missing %></div><% } %></td>
                <td><% if (r.numbering == null) { %><span class="molecule_sub">none</span><% } else { %><%= r.numbering %><% } %></td>
                <td><% if (!r.links.length) { %><span class="molecule_sub">none</span><% } %><% for (const l of r.links) { %><div><% if (l.url) { %><a target="_blank" rel="noopener" href="<%= l.url %>"><%= l.text %></a><% } else { %><%= l.text %><% } %></div><% } %></td>
            </tr>
            <% if (r.sequence) { %>
                <tr class="sequence_row"><td colspan="5">
                    <details class="sequence">
                        <summary>Show sequence</summary>
                        <div class="sequence_body">
                            <% for (const line of r.sequence.lines) { %><div><span class="sequence_num"><%= line.start %></span><span class="sequence_text"><% for (const run of line.runs) { %><% if (run.mark) { %><span class="sequence_<%= run.mark %>" title="<%= run.title %>"><%= run.text %></span><% } else { %><%= run.text %><% } %><% } %></span></div><% } %>
                        </div>
                        <div class="sequence_foot">
                            <% if (r.sequence.modified) { %><span><span class="sequence_modified">G</span> modified, shown as its parent; hover for the code</span><% } %>
                            <% if (r.sequence.unmodelled) { %><span><span class="sequence_unmodelled">C</span> not modelled in any chain</span><% } %>
                            <span class="sequence_actions">
                                <button type="button" class="sequence_copy" title="Copy sequence" aria-label="Copy sequence"><svg class="icon_copy" viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg><svg class="icon_done" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg></button>
                                <a class="sequence_fasta" href="/structure/<%= entry.pdb_id %>/fasta/<%= r.entity_id %>" download title="Download as FASTA"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>FASTA</a>
                            </span>
                        </div>
                    </details>
                </td></tr>
            <% } %>
        <% } %>
    <% } else { %>
        <colgroup><col style="width:12%"><col style="width:70%"><col style="width:18%"></colgroup>
        <tr><th>Code</th><th>Name</th><th>Count</th></tr>
        <% for (const r of g.rows) { %>
            <tr><td><% if (r.url) { %><a target="_blank" rel="noopener" href="<%= r.url %>"><%= r.code %></a><% } else { %><% if (r.code == null) { %><span class="molecule_sub">none</span><% } else { %><%= r.code %><% } %><% } %></td><td><%= r.name %></td><td><%= r.count %></td></tr>
        <% } %>
    <% } %>
    </table>
    </div>
</details>
