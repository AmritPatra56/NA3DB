<%#
  The one "?" on the site: a round button that opens a short note. The text
  comes from help_texts.js by key (app.locals.help), so wording changes there.
  Usage: include("includes/help", { key: "base-pairs" })
%>
<% if (!(key in help)) throw new Error(`no help text for "${key}" in help_texts.js`); %>
<details class="help">
    <summary aria-label="What this section shows" title="What this section shows">?</summary>
    <p><%= help[key] %></p>
</details>
