<div class="rail">
    <div class="rail-icons">
        <a href="/" class="rail-logo" title="NA3DB home" aria-label="NA3DB home">
            <svg viewBox="0 0 34 34" aria-hidden="true">
                <rect width="34" height="34" rx="8" fill="#2563eb"/>
                <text x="17" y="15" text-anchor="middle" font-size="11" font-weight="800" fill="#fff">NA</text>
                <text x="17" y="27" text-anchor="middle" font-size="11" font-weight="800" fill="#bfdbfe">3D</text>
            </svg>
        </a>
<%# rail_query is for the pages that load no script of their own: the structure
    page cannot run sync_rail_links, so its links are built here. %>
        <% const carry = typeof rail_query === "undefined" ? "" : rail_query; %>
        <a href="/search<%= carry %>" class="rail-item <%= page === "search" ? "active" : "" %>" data-page="/search" title="Full search" aria-label="Full search">
            <img src="/assets/search.svg" alt="Search">
        </a>
        <a href="#" class="rail-item" title="Questions">
            <img src="/assets/Q.png" alt="Questions" class="icon-narrow">
        </a>
        <%# A report covers a search, so it is not offered before there is one. %>
        <% if (page !== "landing") { %>
        <a href="/report<%= carry %>" class="rail-item <%= page === "report" ? "active" : "" %>" data-page="/report" title="Report">
            <img src="/assets/report.svg" alt="Report">
        </a>
        <% } %>
    </div>
    <%# Hidden until public/theme.js runs: without it the button could not work.
        The icon shown is the current choice. %>
    <button type="button" class="rail-item rail-theme" data-choice="auto" hidden
            title="Theme: auto, follows your device" aria-label="Theme: auto, follows your device">
        <svg class="theme_auto" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg>
        <svg class="theme_light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <svg class="theme_dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
    </button>
    <div class="rail-brand">NA3DB</div>
</div>
