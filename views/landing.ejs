<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NA3DB</title>
    <link rel="icon" href="/assets/favicon.ico">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="interface">
        <%- include("includes/rail.ejs") %>

        <div class="landing_page">
        <div class="landing">
            <div class="landing_inner">
                <h1 class="landing_title">NA3DB</h1>
                <p class="landing_tagline">Nucleic Acid 3D Database</p>

                <%# A plain GET form: the box works before any script runs, and
                    submitting lands on a real, shareable /search?q= address. %>
                <form class="landing_search" action="/search" method="get">
                    <input type="text" name="q" autofocus autocomplete="off"
                           placeholder="Search an id, molecule, author or organism">
                    <button type="submit">Search</button>
                </form>

                <p class="landing_count"></p>

                <p class="landing_examples">
                    <span class="landing_examples_label">Try</span>
                    <% for (const example of registry.examples) { %>
                        <a href="<%= example.url %>">
                            <strong><%= example.term %></strong>
                            <span><%= example.kind %></span>
                        </a>
                    <% } %>
                </p>

                <%# Three ways in for someone with no term in mind. Every row
                    is a filter link; its number and bar come from the same
                    query (search.js browse_counts). %>
                <p class="browse_lead">Not sure what to type? Start from what you know.</p>
                <div class="browse">
                    <% for (const group of browse) { %>
                    <section class="browse_card">
                        <h2><%= group.question %></h2>
                        <p class="browse_hint"><%= group.hint %></p>
                        <ul>
                            <% for (const row of group.rows) { %>
                            <li><a href="<%= row.url %>">
                                <span class="browse_name"><%= row.label %><% if (row.note) { %> <small><%= row.note %></small><% } %></span>
                                <span class="browse_count"><%= row.count.toLocaleString("en-GB") %></span>
                                <span class="browse_bar" style="--share: <%= row.share.toFixed(3) %>"></span>
                            </a></li>
                            <% } %>
                        </ul>
                    </section>
                    <% } %>
                </div>

                <a class="landing_advanced" href="/search?panel=open">Advanced search</a>

                <%# Both from the database, so the line moves with every load. %>
                <p class="landing_stats">
                    <b><%= stats.total.toLocaleString("en-GB") %></b> structures<% if (stats.updated) { %>
                    · updated <%= stats.updated.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "Europe/Prague" }) %><% } %>
                </p>
            </div>
        </div>
        <%- include("includes/footer.ejs") %>
        </div>
    </div>

    <%# An addition, not a dependency: the form above is a plain GET and works
        with or without this. %>
    <script src="/landing.js"></script>
</body>
</html>
