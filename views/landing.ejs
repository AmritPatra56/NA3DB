                    </svg>
                </h1>
                <p class="landing_tagline">Nucleic Acid 3D Database</p>

                <%# A plain GET form: the box works before any script runs, and
                    submitting lands on a real, shareable /search?q= address. %>
                <form class="landing_search" action="/search" method="get">
                    <div class="landing_field">
                        <%# Shown by pick.js once a row is ticked: what is ticked,
                            and the way to drop it. It stands where the invitation
                            to type stands, because by then the box is saying what
                            the search asks. The box's own Search runs it; there is
                            no second search here. %>
                        <div class="picked_line" hidden>
                            <p class="pick_what"></p>
                            <button type="button" class="pick_clear">Clear</button>
                        </div>
                        <input type="text" name="q" autofocus autocomplete="off"
                               placeholder="Search an id, molecule, author or organism">
                        <%# How many structures the ticked rows find, written by
                            pick.js inside the box it belongs to. %>
                        <p class="pick_count" aria-live="polite"></p>
                    </div>
                    <button type="submit">Search</button>
                </form>

                <p class="landing_count"></p>

                <%# Five ways in for someone with no term in mind, each
                    placed by its filters.js BROWSE area. Every row is a
                    question with a Yes and a No, each a filter link; its
                    number and bar come from the query Yes runs
                    (search.js browse_counts). %>
                <p class="browse_lead">Not sure what to type? Start from what you know.</p>
                <%# An option under a row: a link, number, tick box and bar.
                    Its note is a chemical or common name, cut to one line,
                    with the whole of it on hover. %>
                <% const browse_option = (o) => { %>
                                    <li><a href="<%= o.url %>"<% if (o.say) { %> data-say="<%= o.say %>"<% } %>>
                                        <span class="browse_name"><%= o.label %><% if (o.note) { %> <small title="<%= o.note %>"><%= o.note %></small><% } %></span>
                                        <span class="browse_count"><%= o.count.toLocaleString("en-GB") %></span>
                                        <span class="browse_tick" aria-hidden="true"></span>
                                        <span class="browse_bar" style="--share: <%= o.share.toFixed(3) %>"></span>
                                    </a></li>
                <% } %>
                <div class="browse">
                    <% for (const group of browse) { %>
                    <section class="browse_card" style="grid-area: <%= group.area %>">
                        <h2><%= group.question %></h2>
                        <p class="browse_hint"><%= group.hint %></p>
                        <ul class="browse_rows">
                            <% for (const row of group.rows) { %>
                            <li class="browse_row">
                                <a class="browse_link" href="<%= row.url %>">
                                    <span class="browse_name"><%= row.label %></span>
                                    <span class="browse_count"><%= row.count.toLocaleString("en-GB") %></span>
                                    <span class="browse_bar" style="--share: <%= row.share.toFixed(3) %>"></span>
                                </a>
                                <span class="browse_answer" role="group" aria-label="<%= row.label %>">
                                    <%# The chevron says this row has more inside: Yes opens its options.
                                        Only rows that have any carry it, and style.css keeps it out of
                                        sight until pick.js is there to open anything. %>
                                    <a class="browse_yes" href="<%= row.url %>" data-say="<%= row.say_yes %>">Yes<% if (row.options.length) { %><i class="arrow" aria-hidden="true"></i><% } %></a>
                                    <a class="browse_no" href="<%= row.no_url %>" data-say="<%= row.say_no %>">No</a>
                                </span>
                                <%# Opened by pick.js while Yes is on. %>
                                <% if (row.options.length) { %>
                                <div class="browse_options" hidden>
                                    <p class="browse_options_name"><%= row.options_name ?? `${row.options.length} most frequent` %> <small>Tick any to narrow it down</small></p>
                                    <ul aria-label="<%= row.label %>, <%= (row.options_name ?? "most frequent").toLowerCase() %>">
                                        <% for (const o of row.options) browse_option(o) %>
                                    </ul>
                                </div>
                                <% } %>
                            </li>
                            <% } %>
                        </ul>
                        <% if (group.foot) { %>
                        <p class="browse_foot"><%= group.foot.text %></p>
                        <% } %>
                    </section>
                    <% } %>
                </div>

                <a class="download download_quiet landing_advanced" href="/search?panel=open">Full search</a>

                <%# Both from the database, so the line moves with every load. %>
                <p class="landing_stats">
                    <b><%= stats.total.toLocaleString("en-GB") %></b> structures<% if (stats.updated) { %>
                    · updated <%= stats.updated.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "Europe/Prague" }) %><% } %>
                </p>
            </div>
        </div>

        </div>
    </div>
    <%- include("includes/footer.ejs") %>

    <%# An addition, not a dependency: the form above is a plain GET and works
        with or without this. %>
    <script src="/box_suggest.js"></script>
    <script src="/pick.js"></script>
    <script src="/landing.js"></script>
</body>
</html>
