                    <g transform="translate(-146.4,-2320.3) scale(1.46733)"><path class="mark_word" d="M 1234.1,1647.3 L 1234.1,1581.3 L 1501.3,1581.3 C 1537.6,1581.3 1568.8,1594.5 1594.9,1620.9 C 1621,1647.3 1634.1,1678.6 1634.1,1714.9 L 1634.1,1747.7 C 1634.1,1787.2 1623,1818 1600.9,1840.1 C 1578.8,1862.2 1563.6,1875 1519.3,1880.3 C 1563.6,1880.3 1578.8,1894.8 1600.9,1921.7 C 1623,1948.6 1634.1,1979.7 1634.1,2014.9 L 1634.1,2047.7 C 1634.1,2084 1621,2115.3 1594.9,2141.7 C 1568.8,2168.1 1537.6,2181.3 1501.3,2181.3 L 1234.1,2181.3 L 1234.1,2115.3 L 1434.1,2114.9 C 1452.8,2114.9 1468.6,2108.2 1481.7,2094.9 C 1494.8,2081.6 1501.3,2065.8 1501.3,2047.7 L 1501.3,1981.3 C 1501.3,1937 1436.1,1909.9 1436.1,1909.9 L 1350.5,1874.1 L 1350.5,1820.5 C 1390.3,1834.9 1426.7,1847.4 1434.1,1847.7 C 1451.2,1848.4 1468.6,1841.2 1481.7,1828.1 C 1494.8,1815 1501.3,1799.4 1501.3,1781.3 L 1501.3,1714.9 C 1501.3,1696.2 1494.8,1680.4 1481.7,1667.3 C 1468.6,1654.2 1452.8,1647.7 1434.1,1647.7 L 1234.1,1647.3 Z"/></g>
                    <g transform="translate(-150.5,-2320.3) scale(1.46733)"><path class="mark_word" d="M 1770.5,2181.3 L 1770.5,1581.3 L 2037.7,1581.3 C 2074,1581.3 2105.2,1594.5 2131.3,1620.9 C 2157.4,1647.3 2170.5,1678.6 2170.5,1714.9 L 2170.5,2047.7 C 2170.5,2084 2157.4,2115.3 2131.3,2141.7 C 2105.2,2168.1 2074,2181.3 2037.7,2181.3 L 1770.5,2181.3 Z M 1904.1,2114.9 L 1970.5,2114.9 C 1989.2,2114.9 2005,2108.2 2018.1,2094.9 C 2031.2,2081.6 2037.7,2065.8 2037.7,2047.7 L 2037.7,1714.9 C 2037.7,1696.2 2031.2,1680.4 2018.1,1667.3 C 2005,1654.2 1989.2,1647.7 1970.5,1647.7 L 1904.1,1647.7 L 1904.1,2114.9 Z"/></g>
