<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NA3DB report</title>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/assets/favicon.ico" sizes="32x32">
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
    <link rel="stylesheet" href="/style.css">
<%- include("includes/theme.ejs") %>
</head>
<body>
    <div class="interface">
        <%- include("includes/rail.ejs") %>
        <div class="query_panel <%= fields_open ? "" : "folded" %>" id="report_panel">
            <div class="query_panel_header">
                <h1>Report</h1>
            </div>
<%# One tab per table. A table holds one kind of row, so a structure's paper
    and a molecule's sequence can never be ticked into the same file. %>
            <div class="report_tabs" role="tablist" aria-label="Report tables">
                <% for (const t of registry.report_tables) { const on = t.key === table; %>
                <button type="button" class="report_tab" role="tab" id="table-<%= t.key %>"
                        data-table="<%= t.key %>" aria-controls="report_fields"
                        aria-selected="<%= on %>"<% if (!on) { %> tabindex="-1"<% } %>><%= t.name %></button>
                <% } %>
            </div>
            <details class="guide report_why">
                <summary>Why three tables?</summary>
                <div class="guide_body"><p><%= help["report-tables"] %></p></div>
            </details>
            <div class="query_panel_body" id="report_fields" role="tabpanel" aria-labelledby="table-<%= table %>"></div>
            <div class="query_panel_footer">
                <div class="report_downloads">
                    <button type="button" class="download" id="export_button">Download CSV</button>
                    <button type="button" class="download" id="zip_button">Download all (ZIP)</button>
                </div>
            </div>
        </div>
<%# The full search's drawer handle on the list's edge: folded, the list
    slides away and the handle stays on the page's edge. A phone has the
    Fields button over the table instead. The state goes in the URL, so a
    link opens the way it was left. %>
        <div class="panel_edge">
            <button type="button" class="panel_handle fields_handle" aria-controls="report_panel"
                    aria-expanded="<%= fields_open %>"
                    aria-label="<%= fields_open ? "Hide the fields" : "Show the fields" %>"
                    title="<%= fields_open ? "Hide the fields" : "Show the fields" %>">
                <i class="arrow arrow_side" aria-hidden="true"></i>
            </button>
        </div>
        <div class="results_area">
            <div class="results_area_header">
                <h1 class="report_count"><%= registry.report_tables.find((t) => t.key === table).name %></h1>
<%# On a phone, opens or shuts the field list above the table. %>
                <button type="button" class="fields_toggle"
                        aria-expanded="<%= fields_open %>"
                        aria-label="Show or hide the fields">
                    <i class="arrow arrow_side" aria-hidden="true"></i>
                </button>
            </div>
            <div class="results_area_body report_body">
<%# The file as it will be downloaded. Built from the same fields and the same
    escaping as the CSV, so what is on screen is what lands in the file. %>
                <div class="report_preview"></div>
            </div>
        </div>
    </div>
    <!-- Injected, not fetched: the scripts below run at once and need it. -->
    <script>window.REGISTRY = <%- registry_json %>;</script>
    <script src="/api.js"></script>
    <script src="/shared.js"></script>
    <script src="/zip.js"></script>
    <script src="/report.js"></script>
    <%- include("includes/footer.ejs") %>
</body>
</html>
