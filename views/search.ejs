<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NA3DB</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="interface">
        <%- include("includes/rail.ejs") %>

        <div class="workspace">
<%# The prominent filters, across the top. The input carries form="query_form",
    so Enter submits the panel below it and app.js needs no new listener:
    read_filters finds an input by id wherever it sits on the page. %>
            <div class="top_search">
<%# Column one of the bar, which was empty. Putting it here keeps the box on
    the centre line and the switch beside the thing it changes. %>
                <div class="match_switch" role="group" aria-label="How the search matches">
                <% for (const mode of registry.match_modes) { %>
                    <button type="button" data-match="<%= mode.key %>"
                            aria-pressed="<%= match === mode.key %>"><%= mode.label %></button>
                <% } %>
                </div>

                <div class="top_search_box">
                <% for (const f of registry.filters.filter((x) => x.prominent)) { %>
                    <input type="text" id="<%= f.key %>" name="<%= f.key %>"
                           form="query_form" autocomplete="off"
                           placeholder="Search an id, molecule, author or organism">
                    <button type="submit" form="query_form">Search</button>
                <% } %>
                </div>
                <button type="button" class="filters_toggle"
                        aria-expanded="<%= panel_open %>">Filters</button>
            </div>

            <div class="workspace_body">
        <form class="query_panel <%= panel_open ? "" : "hidden" %>" id="query_form">
            <div class="query_panel_header">
                <h1>Structure query</h1>
            </div>
            <div class="query_panel_body">
<%# The form, generated from the registry. Nothing here names a filter. %>
<% for (const group of registry.groups) { %>
    <%
        // A range filter draws its partner, so note what is already drawn.
        const mine  = registry.filters.filter((f) => f.group === group.name);
        const drawn = new Set();
    %>
                <div class="category <%= group.slug %>">
                    <div class="category_header">
                        <div class="category_title">
                            <span class="category_dot"></span>
                            <h2><%= group.name %></h2>
                        </div>
                        <img src="/assets/arrow.svg" alt="" class="category_arrow">
                    </div>

                    <div class="category_body">
                    <% for (const f of mine) { %>
                        <% if (drawn.has(f.key)) continue; %>
                        <%# a prominent filter has its own place above the panel %>
                        <% if (f.prominent) continue; %>
                        <% drawn.add(f.key); %>

                        <% if (f.kind === "text") { %>
                        <div class="field">
                            <label for="<%= f.key %>"><%= f.label %></label>
                            <input type="text" id="<%= f.key %>" name="<%= f.key %>">
                        </div>

                        <% } else if (f.kind === "range") { %>
                        <% const hi = mine.find((x) => x.key === f.pair_with); %>
                        <% drawn.add(hi.key); %>
                        <div class="field">
                            <div class="group_label"><%= f.label %></div>
                            <div class="range_row">
                                <input type="number" id="<%= f.key %>" name="<%= f.key %>"
                                       placeholder="<%= f.placeholder %>">
                                <span class="range_dash"></span>
                                <input type="number" id="<%= hi.key %>" name="<%= hi.key %>"
                                       placeholder="<%= hi.placeholder %>">
                            </div>
                        </div>

                        <% } else { %>
                        <div class="pill_group">
                            <div class="group_label"><%= f.label %></div>
                            <div class="pill_field" data-name="<%= f.key %>">
                                <% if (f.any) { %>
                                <button type="button" class="pill selected" data-value="any">Any</button>
                                <% } %>
                                <% for (const o of f.options) { %>
                                <button type="button" class="pill" data-value="<%= o.value %>"><%= o.label %></button>
                                <% } %>
                            </div>
                        </div>
                        <% } %>
                    <% } %>

                    <% if (group.note) { %>
                        <p class="field_note"><%= group.note %></p>
                    <% } %>
                    </div>
                </div>
<% } %>
            </div>


            <div class="query_panel_footer">
                <button type="submit" class="search">Search</button>
            </div>


        </form>
        <div class="results_area">
            <div class="results_area_header">
                <div class="results_count">
                    <h1>Entries (0)</h1>
<%# A number box, not a list: type any whole number. The suggestions are a
    convenience and the max is the cap the server enforces anyway. %>
                    <label class="per_page_field">
                        <span>Show</span>
                        <input type="number" id="per_page" name="per_page"
                               list="per_page_options" inputmode="numeric"
                               min="1" max="<%= registry.max_page_size %>" step="1"
                               value="<%= registry.default_page_size %>">
                        <datalist id="per_page_options">
                        <% for (const n of registry.page_size_suggestions) { %>
                            <option value="<%= n %>"></option>
                        <% } %>
                        </datalist>
                        <span>per page</span>
                    </label>
                </div>
                <div class="results_tools">
<%# Two renderings of the same reply. Switching redraws from what the browser
    already has, so it never asks the server again. %>
                    <div class="view_switch" role="group" aria-label="Result layout">
                        <button type="button" data-view="cards"
                                aria-pressed="<%= view === "cards" %>">Cards</button>
                        <button type="button" data-view="lines"
                                aria-pressed="<%= view === "lines" %>">Lines</button>
                    </div>
                    <label class="sort_field">
                        <span>Sort by</span>
                        <select id="sort_by" name="sort">
                        <% for (const s of registry.sorts) { %>
                            <option value="<%= s.key %>"><%= s.label %></option>
                        <% } %>
                        </select>
                    </label>
                    <span class="results_range">1 – 50 of 0</span>
                </div>
            </div>
            <div class="results_area_body">
                <div class="results_list"></div>
                <div class="loading_state hidden">
                    <span class="spinner"></span>
                    <span>Searching...</span>
                </div>
                <div class="error_state hidden">
                    <span class="error_text"></span>
                </div>
                <div class="empty_state">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8" />
                        <path d="m21 21-4.35-4.35" />
                        <path d="M11 8v6M8 11h6" />
                    </svg>
                    <span>No entries found</span>
                </div>
            </div>
            <div class="pagination"></div>
        </div>
            </div>
        </div>
    </div>
    <!-- Injected, not fetched: the scripts below run at once and need it. -->
    <script>window.REGISTRY = <%- registry_json %>;</script>
    <script src="/api.js"></script>
    <script src="/shared.js"></script>
    <script src="/app.js"></script>
</body>
</html>