# Copy this file to .env and adjust the values.
# .env itself is never committed, because it holds the database password.
PORT=4000

# The PostgreSQL database. Create it with:
#   createdb na3db
#   psql -d na3db -f db/init.sql
#   node db/make_seed.mjs && psql -d na3db -f db/seed.sql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=na3db
DB_USER=na3db
DB_PASSWORD=change_me
