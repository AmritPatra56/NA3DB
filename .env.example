# Copy to .env and set the values. .env itself is never committed.
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=na3db
DB_USER=na3db
DB_PASSWORD=change_me

# The tests read .env.test, which differs on one line: DB_NAME=na3db_test
# Make it by copying this file. Both .env and .env.test are gitignored.
#
# Setup is in the README. In short:
#   node --env-file-if-exists=.env db/migrate.mjs     # schema
#   psql -h localhost -U na3db -d na3db -f db/seed.sql
